# ===========================================================================
# AskMyData — environment configuration
# Copy this file to ".env" and fill in your real values.
# NEVER commit the real .env file (it is git-ignored).
# ===========================================================================

# --- Django ---------------------------------------------------------------
DJANGO_SECRET_KEY=change-me-to-a-long-random-string
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# --- Snowflake connection --------------------------------------------------
# ACCOUNT: your account identifier. In Snowsight go to the bottom-left account
#   menu -> hover your account -> "Copy account identifier". It looks like
#   "ABCDEFG-XY12345" (org-account) or "xy12345.us-east-1".
SNOWFLAKE_ACCOUNT=

# The username and password you log into Snowsight with.
SNOWFLAKE_USER=
SNOWFLAKE_PASSWORD=

# Optional. Leave blank to use your default role. ACCOUNTADMIN works for trials.
SNOWFLAKE_ROLE=

# A virtual warehouse (compute). Trials come with COMPUTE_WH already created.
SNOWFLAKE_WAREHOUSE=COMPUTE_WH

# The demo dataset. These defaults use Snowflake's built-in free sample data —
# no upload needed. Leave as-is unless you want to point at your own data.
SNOWFLAKE_DATABASE=SNOWFLAKE_SAMPLE_DATA
SNOWFLAKE_SCHEMA=TPCH_SF1

# Cortex LLM used for the agent. mistral-large2 is broadly available.
# Alternatives: llama3.1-70b, llama3.1-8b, mixtral-8x7b
SNOWFLAKE_CORTEX_MODEL=mistral-large2

# --- LLM provider / fallback ----------------------------------------------
# Snowflake Cortex is preferred, but trial accounts have it DISABLED. Set the
# provider strategy here:
#   auto   -> try Cortex first, fall back to Groq/Gemini (recommended)
#   cortex -> Cortex only (needs a paid/enabled account)
#   groq   -> Groq only
#   gemini -> Gemini only
LLM_PROVIDER=auto

# Free Groq key (fast, recommended fallback): https://console.groq.com/keys
# Leave GROQ_MODEL blank to auto-detect a currently-available model (Groq
# retires model IDs periodically, so auto-detect avoids 404s).
GROQ_API_KEY=
GROQ_MODEL=

# Free Google Gemini key (alternative): https://aistudio.google.com/app/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash

# --- Django's internal database (NOT your analytical data) ----------------
# The app stores no business data locally, so the zero-setup default is fine.
# DB_ENGINE=sqlite   (default — nothing else needed)
# To use MySQL instead, set DB_ENGINE=mysql and fill the values below.
DB_ENGINE=sqlite
DB_NAME=askmydata
DB_USER=root
DB_PASSWORD=
DB_HOST=127.0.0.1
DB_PORT=3306
